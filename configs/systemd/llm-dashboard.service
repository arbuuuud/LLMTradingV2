[Unit]
Description=LLMTradingV2 Institutional Web Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/LLMTradingV2
Environment="PYTHONPATH=/home/ubuntu/LLMTradingV2"
Environment="PORT=8080"
ExecStart=/home/ubuntu/LLMTradingV2/.venv/bin/python3 -m src.dashboard.server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
